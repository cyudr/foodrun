# GEMINI_KEY / GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_KEY="YOUR_GEMINI_KEY"
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Chef Pro Invitation Codes: Any environment variable starting with "vibe_" (or "VIBE_")
VIBE_CHEF="CHEF2026"
VIBE_VIP="VIPCHEF"
VIBE_EARLY_ACCESS="VIBECOOK"
