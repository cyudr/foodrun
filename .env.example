# GEMINI_KEY / GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_KEY="YOUR_GEMINI_KEY"
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# mealDB_KEY: API key for TheMealDB (use "1" for the free test tier or your premium key).
mealDB_KEY="1"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
